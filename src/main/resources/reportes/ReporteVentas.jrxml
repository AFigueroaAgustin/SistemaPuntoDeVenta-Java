<jasperReport name="ReporteVentas" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="2990c9f6-9372-4052-b2fb-240f3e9d8614">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="tienda los figueroa"/>
	<query language="SQL"><![CDATA[SELECT 
    v.idVenta,
    v.fechaVen,
    v.metodoPago,
    v.totalVenta,
    p.nombre,
    dv.cant,
    dv.precioUnitarioVenta
FROM Venta v
INNER JOIN DetalleVenta dv ON v.idVenta = dv.idVenta
INNER JOIN Producto p ON dv.idProducto = p.id]]></query>
